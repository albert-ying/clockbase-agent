        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "entity": {
          "type": "string",
          "pattern": "^GSE[0-9]+$|^GSM[0-9]+$"
        },
        "field": {
          "type": "string",
          "pattern": "^!(Series|Sample)_[A-Za-z0-9_]+$"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_role",
        "source_path",
        "source_sha256",
        "entity",
        "field",
        "line_start",
        "line_end",
        "quote"
      ],
      "description": "The complete literal SOFT field value at this raw-file field/line locator. No whitespace normalization. The adapter verifies field boundaries, entity, exact value, allowed path and hash."
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "CANNOT VERIFY"
          ]
