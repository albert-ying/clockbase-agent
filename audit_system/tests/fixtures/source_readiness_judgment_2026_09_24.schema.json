          "minItems": 0
        }
      },
      "required": [
        "status",
        "material",
        "rationale",
        "evidence_ids",
        "fact_ids",
        "unresolved_ids"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "fact_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "CANNOT VERIFY"
              }
            }
          },
          "then": {
            "properties": {
              "unresolved_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "material": {
                "enum": [
                  false,
                  null
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "then": {
            "properties": {
              "material": {
                "enum": [
                  false,
                  null
                ]
              }
            }
          }
        }
      ]
    },
    "fact": {
